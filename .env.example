# CHAMP Toolkit & MCP Knowledge Assistant Environment Configuration

# Core AI Studio configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Airtable Integration (Required for MCP Knowledge Assistant & live data sync)
AIRTABLE_BASE_ID="app..."
AIRTABLE_PAT="pat..."

# Server Port (Defaults to 3000 in dev and Render's PORT in production)
PORT=3000

# Optional MCP Client Authentication Token
# When set, MCP clients (such as ChatGPT custom actions / MCP connectors) must provide:
# Authorization: Bearer <MCP_AUTH_TOKEN> or X-MCP-Token: <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN="champ_mcp_secret_token_12345"
