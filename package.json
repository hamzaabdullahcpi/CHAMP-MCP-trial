{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:mcp": "esbuild src/mcp/standalone.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/mcp.cjs",
    "prebuild": "node generate_oecd.cjs && node generate_airtable.cjs",
    "update-data": "node generate_oecd.cjs && node generate_airtable.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "start:mcp": "node dist/mcp.cjs",
    "mcp": "tsx src/mcp/standalone.ts",
    "test": "tsx tests/mcp-tools.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "d3-geo-projection": "^4.0.0",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "zod": "^4.6.7",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-simple-maps": "^3.0.6",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  }
}